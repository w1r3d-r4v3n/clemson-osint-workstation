#!/usr/bin/env bash
set -uo pipefail

failures=0
warnings=0

pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; failures=$((failures + 1)); }
warn() { printf 'WARN  %s\n' "$1"; warnings=$((warnings + 1)); }

required=(python3 exiftool ffmpeg ffprobe convert identify mediainfo pdfinfo jq sqlite3 dig whois qgis libreoffice keepassxc yt-dlp age openssl osint-case osint-audit-verify)

echo "Clemson OSINT Workstation health check"
echo
for command in "${required[@]}"; do
  if command -v "${command}" >/dev/null 2>&1; then pass "${command}"; else fail "${command} not found"; fi
done
for forbidden in torbrowser-launcher openvpn wg-quick proxychains4 torsocks nmap nc sherlock maigret gallery-dl instaloader; do
  if command -v "${forbidden}" >/dev/null 2>&1; then fail "${forbidden} is present in the managed baseline"; else pass "${forbidden} is absent"; fi
done

if [[ -r /opt/clemson-osint/VERSION ]]; then
  pass "kit version $(tr -d '\r\n' < /opt/clemson-osint/VERSION)"
else
  fail "kit version file missing"
fi

if [[ -d "${HOME}/Cases" ]]; then
  mode="$(stat -c '%a' "${HOME}/Cases" 2>/dev/null || true)"
  if [[ "${mode}" == "700" ]]; then pass "case folder permissions are 700"; else warn "case folder mode is ${mode:-unknown}; expected 700"; fi
else
  fail "${HOME}/Cases is missing"
fi

if systemctl is-active --quiet ufw.service 2>/dev/null; then
  pass "guest firewall active"
else
  fail "guest firewall is not active"
fi

if systemctl is-active --quiet auditd.service 2>/dev/null; then pass "kernel audit service active"; else fail "kernel audit service inactive"; fi
if systemctl is-active --quiet acct.service 2>/dev/null; then pass "privacy-minimized process accounting active"; else fail "process accounting inactive"; fi
if [[ -r /etc/audit/rules.d/clemson-osint.rules ]] && grep -q 'clemson_osint_cases' /etc/audit/rules.d/clemson-osint.rules; then
  pass "classroom audit rules installed"
else
  fail "classroom audit rules missing"
fi
if [[ -f /etc/clemson-osint/managed && -r /etc/clemson-osint/instructor-age-recipient && -r /opt/clemson-osint/audit-public.pem ]]; then
  pass "managed audit and encrypted-export configuration present"
else
  fail "managed audit or encrypted-export configuration missing"
fi
if id -nG "${USER}" | tr ' ' '\n' | grep -Eq '^(sudo|admin|wheel)$'; then
  fail "student account retains administrator membership"
else
  pass "student account is not an administrator"
fi

echo
printf 'Result: %d failure(s), %d warning(s).\n' "${failures}" "${warnings}"
[[ "${failures}" -eq 0 ]]
